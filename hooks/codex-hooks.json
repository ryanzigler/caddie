{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/suppression-guard.sh\"",
            "type": "command"
          },
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/js-style-guard.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/destructive-git-guard.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/user-instructions.sh\"",
            "type": "command"
          },
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/temp-janitor.sh\"",
            "type": "command"
          }
        ]
      }
    ]
  }
}
