{
  "mcpServers": {
    "railway": {
      "command": "railway",
      "args": ["mcp"]
    },
    "harvest": {
      "type": "http",
      "url": "https://api.harvestapp.com/mcp"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    }
  }
}
